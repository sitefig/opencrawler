<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }} | opencrawlers.com</title>
<meta name="description" content="{{ description }}">
<meta name="color-scheme" content="light dark">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="stylesheet" href="/css/site.css">
<script>
  // Google tag. Consent is denied by default and nothing is requested from Google
  // until the visitor says yes (js/consent.js calls opencrawlersLoadAnalytics).
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('consent', 'default', { analytics_storage: 'denied', ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied' });
  window.opencrawlersLoadAnalytics = function () {
    if (window.opencrawlersAnalyticsLoaded) return;
    window.opencrawlersAnalyticsLoaded = true;
    gtag('consent', 'update', { analytics_storage: 'granted' });
    gtag('js', new Date());
    gtag('config', 'G-H66KE712HC');
    var t = document.createElement('script');
    t.async = true;
    t.src = 'https://www.googletagmanager.com/gtag/js?id=G-H66KE712HC';
    document.head.appendChild(t);
  };
</script>
<script type="module" src="/js/consent.js"></script>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header><div class="wrap">
<a class="brand" href="/">open<b>crawlers</b></a>
<nav aria-label="Main"><ul>
<li><a href="/"{% if page.url == "/" %} aria-current="page"{% endif %}>Stats</a></li>
<li><a href="/bots/"{% if page.url == "/bots/" %} aria-current="page"{% endif %}>AI crawlers</a></li>
<li><a href="/method/"{% if page.url == "/method/" %} aria-current="page"{% endif %}>Method</a></li>
<li><a href="https://sus.bot">Check your site</a></li>
<li><a href="https://app.sitefig.net/signup/" rel="noopener">Free account</a></li>
</ul></nav>
</div></header>
<main id="main" class="wrap">
{{ content | safe }}
<aside class="cta" aria-labelledby="cta-h">
<h2 id="cta-h">What does your robots.txt say?</h2>
<p>These numbers cover {{ stats.hosts_with_robots | m }} sites. <a href="https://sus.bot">sus.bot</a> checks yours in seconds: which AI crawlers are blocked, which paths are exposed, and how your server really answers each bot. Free.</p>
<p><a href="https://app.sitefig.net/signup/" rel="noopener">Sign up for a free sus.bot account</a> to get updates when these numbers change and when your own robots.txt changes.</p>
</aside>
</main>
<footer><div class="wrap">
<p>Data: Common Crawl robots.txt captures, {{ stats.crawls }} crawls, 2026. Built by <a href="https://sus.bot">sus.bot</a>. <a href="/method/">How we count</a>. <a href="/privacy/">Privacy</a>. <button type="button" class="linklike" id="consent-open">Cookie settings</button></p>
</div></footer>
<dialog id="consent" class="consent" aria-labelledby="consent-title" aria-describedby="consent-body">
<h2 id="consent-title">Before you start: analytics</h2>
<p id="consent-body">We would like to count visits with Google Analytics, which sets cookies in your browser and sends Google the page you are on. It is not needed to read this site, so it is your choice, and the site works exactly the same either way.</p>
<p><a href="/privacy/">What we collect, and how to change your mind</a></p>
<div class="consent__actions">
<button type="button" class="button" id="consent-reject">No cookies</button>
<button type="button" class="button" id="consent-accept" autofocus>Allow cookies</button>
</div>
</dialog>
</body>
</html>
